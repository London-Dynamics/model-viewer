{
  "name": "threejs-water-pro",
  "version": "3.5.1",
  "license": "LICENSE.md",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host --port 3001",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "convert-preset": "tsx scripts/convert-legacy-preset.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo",
    "lint:fix": "eslint src demo --fix",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "peerDependencies": {
    "three": ">=0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.10.1",
    "@types/three": "^0.181.0",
    "eslint": "^9.39.1",
    "terser": "^5.46.1",
    "three": "^0.181.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.0.1",
    "vitepress": "^1.5.0"
  }
}
