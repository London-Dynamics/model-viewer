{
  "name": "threejs-water-pro",
  "version": "3.0.0",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host --port 3001",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo",
    "lint:fix": "eslint src demo --fix",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:docs": "bash __tests__/doc-projects/setup.sh"
  },
  "peerDependencies": {
    "three": ">=0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@inquirer/prompts": "^8.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.10.1",
    "@types/three": "^0.181.0",
    "acorn": "^8.15.0",
    "assemblyscript": "^0.28.10",
    "canvas": "^3.2.0",
    "eslint": "^9.39.1",
    "terser": "^5.46.1",
    "three": "^0.181.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.0.1",
    "vitepress": "^1.5.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
